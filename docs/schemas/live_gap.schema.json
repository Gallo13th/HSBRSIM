{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsagent.local/schemas/live_gap.schema.json",
  "title": "LiveGapRecord",
  "description": "A live->simulator gap entry (see docs/LIVE_TO_SIM_GAP.md)",
  "type": "object",
  "required": ["id", "operation", "category", "priority", "status", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^L[0-9]{2,}$"},
    "operation": {"type": "string"},
    "category": {
      "type": "string",
      "enum": ["live_ui", "env_action", "engine_rule", "observation", "lifecycle"]
    },
    "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
    "status": {"type": "string", "enum": ["open", "fixed", "verified", "wontfix"]},
    "evidence": {
      "type": "object",
      "required": ["actions_jsonl"],
      "properties": {
        "actions_jsonl": {"type": "string"},
        "screenshot": {"type": "string"},
        "state": {"type": "string"},
        "action_note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "expected": {"type": "string"},
    "actual": {"type": "string"},
    "owner": {"type": "string"},
    "fix_commit": {"type": "string"},
    "verified_at": {"type": "string"}
  },
  "additionalProperties": true
}
